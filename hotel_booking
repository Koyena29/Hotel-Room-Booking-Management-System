-- Same test as a procedure (rolls back automatically on any error)
DELIMITER $$
CREATE PROCEDURE sp_book_two_rooms(IN g INT, IN r1 INT, IN r2 INT, IN d1 DATE, IN d2 DATE)
BEGIN
  DECLARE EXIT HANDLER FOR SQLEXCEPTION BEGIN ROLLBACK; SELECT 'Rolled back' AS result; END;
  START TRANSACTION;
  INSERT INTO bookings (guest_id, room_id, check_in, check_out) VALUES (g, r1, d1, d2);
  INSERT INTO bookings (guest_id, room_id, check_in, check_out) VALUES (g, r2, d1, d2);
  COMMIT; SELECT 'Committed' AS result;
END$$
DELIMITER ;
