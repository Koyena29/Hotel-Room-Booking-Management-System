-- STEP 1: Create the database and tables
DROP DATABASE IF EXISTS hotel_db;
CREATE DATABASE hotel_db CHARACTER SET utf8mb4;
USE hotel_db;

CREATE TABLE room_types (
  type_id         INT AUTO_INCREMENT PRIMARY KEY,
  type_name       VARCHAR(30) NOT NULL UNIQUE,
  price_per_night DECIMAL(10,2) NOT NULL CHECK (price_per_night > 0)
);
CREATE TABLE rooms (
  room_id  INT AUTO_INCREMENT PRIMARY KEY,
  room_no  VARCHAR(10) NOT NULL UNIQUE,
  floor_no INT NOT NULL,
  type_id  INT NOT NULL,
  status   ENUM('Available','Booked','Maintenance') NOT NULL DEFAULT 'Available',
  FOREIGN KEY (type_id) REFERENCES room_types(type_id)
);
CREATE TABLE guests (
  guest_id   INT AUTO_INCREMENT PRIMARY KEY,
  guest_code VARCHAR(10) NOT NULL UNIQUE,          -- G001 ... from the CSV
  full_name  VARCHAR(100) NOT NULL,
  email      VARCHAR(120) UNIQUE,
  phone      VARCHAR(15)
);
CREATE TABLE bookings (
  booking_id   INT AUTO_INCREMENT PRIMARY KEY,
  guest_id     INT NOT NULL,
  room_id      INT NOT NULL,
  check_in     DATE NOT NULL,
  check_out    DATE NOT NULL,
  adults       INT NOT NULL DEFAULT 1,
  children     INT NOT NULL DEFAULT 0,
  total_amount DECIMAL(10,2) NOT NULL DEFAULT 0,    -- filled by trigger
  status       ENUM('PENDING','CONFIRMED','CHECKED_IN','COMPLETED','CANCELLED') NOT NULL DEFAULT 'CONFIRMED',
  created_at   TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  CHECK (check_out > check_in),
  FOREIGN KEY (guest_id) REFERENCES guests(guest_id),
  FOREIGN KEY (room_id)  REFERENCES rooms(room_id)
);
CREATE TABLE payments (
  payment_id INT AUTO_INCREMENT PRIMARY KEY,
  booking_id INT NOT NULL,
  amount     DECIMAL(10,2) NOT NULL CHECK (amount > 0),
  method     ENUM('UPI','CARD','CASH','NETBANKING') NOT NULL,
  paid_at    TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (booking_id) REFERENCES bookings(booking_id)
);
CREATE TABLE audit_log (                            -- written by triggers (Step 13)
  log_id INT AUTO_INCREMENT PRIMARY KEY,
  table_name VARCHAR(30), action VARCHAR(30), ref_id INT, note VARCHAR(200),
  logged_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE stg_register (                         -- staging table for the CSV import (Step 15)
  Hotel_Name VARCHAR(80), Guest_ID VARCHAR(10), Guest_Name VARCHAR(100), Room_Number VARCHAR(10),
  Room_Type VARCHAR(30), Check_In DATE, Check_Out DATE, Adults INT, Children INT,
  Booking_Status VARCHAR(20), Nightly_Rate_INR DECIMAL(10,2)
);

