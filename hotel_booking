-- STEP 4: Triggers (business rules inside the database)
DELIMITER $$

-- BEFORE INSERT: block overlapping dates and calculate the total amount
CREATE TRIGGER trg_bookings_bi BEFORE INSERT ON bookings
FOR EACH ROW
BEGIN
  DECLARE v_price DECIMAL(10,2);
  IF NEW.status IN ('PENDING','CONFIRMED','CHECKED_IN') AND EXISTS (
       SELECT 1 FROM bookings
       WHERE room_id = NEW.room_id AND status IN ('PENDING','CONFIRMED','CHECKED_IN')
         AND NEW.check_in < check_out AND NEW.check_out > check_in) THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Room is already booked for these dates';
  END IF;
  SELECT t.price_per_night INTO v_price
    FROM rooms r JOIN room_types t ON t.type_id = r.type_id WHERE r.room_id = NEW.room_id;
  SET NEW.total_amount = v_price * DATEDIFF(NEW.check_out, NEW.check_in);
END$$

-- AFTER INSERT: mark the room as Booked and log it
CREATE TRIGGER trg_bookings_ai AFTER INSERT ON bookings
FOR EACH ROW
BEGIN
  IF NEW.status IN ('PENDING','CONFIRMED','CHECKED_IN') THEN
    UPDATE rooms SET status = 'Booked' WHERE room_id = NEW.room_id;
  END IF;
  INSERT INTO audit_log (table_name, action, ref_id, note)
  VALUES ('bookings','INSERT',NEW.booking_id,CONCAT('Room ',NEW.room_id,' booked, total ',NEW.total_amount));
END$$

-- Challenge 1: AFTER UPDATE - release the room when a booking is CANCELLED or COMPLETED
CREATE TRIGGER trg_bookings_au AFTER UPDATE ON bookings
FOR EACH ROW
BEGIN
  IF NEW.status IN ('CANCELLED','COMPLETED') AND OLD.status NOT IN ('CANCELLED','COMPLETED') THEN
    UPDATE rooms SET status = 'Available' WHERE room_id = NEW.room_id;
    INSERT INTO audit_log (table_name, action, ref_id, note)
    VALUES ('bookings',NEW.status,NEW.booking_id,CONCAT('Room ',NEW.room_id,' released'));
  END IF;
END$$

-- Payments: do not accept more than the booking total, and log every payment
CREATE TRIGGER trg_payments_bi BEFORE INSERT ON payments
FOR EACH ROW
BEGIN
  IF (SELECT IFNULL(SUM(amount),0) FROM payments WHERE booking_id = NEW.booking_id) + NEW.amount >
     (SELECT total_amount FROM bookings WHERE booking_id = NEW.booking_id) THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Payment is more than the booking total';
  END IF;
END$$
CREATE TRIGGER trg_payments_ai AFTER INSERT ON payments
FOR EACH ROW
BEGIN
  INSERT INTO audit_log (table_name, action, ref_id, note)
  VALUES ('payments','INSERT',NEW.booking_id,CONCAT('Paid ',NEW.amount,' by ',NEW.method));
END$$
DELIMITER ;

