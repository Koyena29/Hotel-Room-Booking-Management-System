-- STEP 11: Views
CREATE OR REPLACE VIEW v_available_rooms AS            -- currently available rooms
SELECT r.room_id, r.room_no, t.type_name, t.price_per_night
FROM rooms r JOIN room_types t ON t.type_id = r.type_id
WHERE r.status <> 'Maintenance'
  AND NOT EXISTS (SELECT 1 FROM bookings b WHERE b.room_id = r.room_id
                  AND b.status IN ('PENDING','CONFIRMED','CHECKED_IN')
                  AND CURDATE() >= b.check_in AND CURDATE() < b.check_out);

CREATE OR REPLACE VIEW v_booking_summary AS
SELECT b.booking_id, g.guest_code, g.full_name, r.room_no, t.type_name,
       b.check_in, b.check_out, b.adults, b.children, b.total_amount, b.status,
       IFNULL(SUM(p.amount),0) AS paid
FROM bookings b JOIN guests g ON g.guest_id=b.guest_id
JOIN rooms r ON r.room_id=b.room_id JOIN room_types t ON t.type_id=r.type_id
LEFT JOIN payments p ON p.booking_id=b.booking_id
GROUP BY b.booking_id, g.guest_code, g.full_name, r.room_no, t.type_name,
         b.check_in, b.check_out, b.adults, b.children, b.total_amount, b.status;

